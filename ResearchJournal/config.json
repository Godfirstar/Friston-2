{
    "watch_interval_seconds":  30,
    "quiet_seconds":  300,
    "minimum_interval_seconds":  1200,
    "max_file_bytes":  262144,
    "max_diff_characters":  90000,
    "max_context_characters":  14000,
    "source_extensions":  [
                              ".py",
                              ".ps1",
                              ".psm1",
                              ".sh",
                              ".json",
                              ".toml",
                              ".yaml",
                              ".yml",
                              ".sql",
