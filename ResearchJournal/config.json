                              ".js",
                              ".ts",
                              ".tsx",
                              ".c",
                              ".cpp",
                              ".h",
                              ".hpp"
                          ],
    "excluded_dirs":  [
                          "ResearchJournal",
                          ".git",
                          ".venv",
                          "venv",
                          "env",
                          "node_modules",
                          "__pycache__",
                          "data",
                          "logs",
                          "outputs",
                          "output",
                          "runs",
                          "models",
                          "checkpoints",
                          "dist",
                          "build",
                          ".vscode",
                          ".idea",
                          ".codex"
                      ],
    "excluded_name_patterns":  [
                                   ".env*",
                                   "*.pem",
                                   "*.key",
                                   "*secret*",
                                   "*credential*",
                                   "*token*",
                                   "*.db",
                                   "*.sqlite",
                                   "*.sqlite3",
                                   "*.log",
                                   "package-lock.json"
                               ],
    "chat_keywords":  [
                          "Friston-2",
                          "PhotoRobot",
                          "CosRobot",
                          "PhotoBot",
                          "LeRobot",
                          "SO-101",
                          "RAG",
                          "ACT",
                          "罗德岛工程部"
                      ],
