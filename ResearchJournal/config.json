{
  "watch_interval_seconds": 30,
  "quiet_seconds": 300,
  "minimum_interval_seconds": 1200,
  "max_file_bytes": 262144,
  "max_diff_characters": 90000,
  "max_context_characters": 14000,
  "source_extensions": [".py", ".ps1", ".psm1", ".sh", ".json", ".toml", ".yaml", ".yml", ".sql", ".md", ".js", ".ts", ".tsx", ".c", ".cpp", ".h", ".hpp"],
  "excluded_dirs": ["ResearchJournal", ".git", ".venv", "venv", "env", "node_modules", "__pycache__", "data", "logs", "outputs", "output", "runs", "models", "checkpoints", "dist", "build", ".vscode", ".idea", ".codex"],
  "excluded_name_patterns": [".env*", "*.pem", "*.key", "*secret*", "*credential*", "*token*", "*.db", "*.sqlite", "*.sqlite3", "*.log", "package-lock.json"],
  "chat_keywords": ["Friston-2", "PhotoRobot", "CosRobot", "PhotoBot", "LeRobot", "SO-101", "RAG", "ACT", "罗德岛工程部"],
  "codex_timeout_seconds": 420,
  "retry_failed_after_seconds": 1800
}
