    "milestone_gate_quiet_seconds":  900,
    "milestone_auto_quiet_seconds":  2700,
    "milestone_auto_confidence":  0.93,
    "trigger_mode":  "timer",
    "timer_interval_seconds":  600,
    "timer_include_paths":  [
                                "friston2/",
                                "main.py",
                                "preview.py"
                            ],
    "timer_source_extensions":  [
                                    ".py",
                                    ".pyi",
                                    ".c",
                                    ".cpp",
                                    ".h",
                                    ".hpp",
                                    ".js",
                                    ".jsx",
                                    ".ts",
                                    ".tsx",
                                    ".sql"
                                ],
    "skip_trivial_notes":  true
}